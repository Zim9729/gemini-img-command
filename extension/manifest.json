{
  "manifest_version": 3,
  "name": "Gemini 批量图片生成面板",
  "version": "2.1.5",
  "description": "gemini.google.com 批量图片生成配置面板：选文件夹 + 填提示词 → 自动循环每张图（上传→发送→等待→按原名下载）",
  "permissions": [],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.google.com/*",
    "https://*.gstatic.com/*",
    "https://*.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
